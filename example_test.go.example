// Copy this to e2e/users_test.go and run: APITEST_ENV=dev go test ./e2e -v
package e2e_test

import (
	"fmt"
	"testing"
	"time"

	"aegion-dynamic/api-console/apitest"
)

// TestUserLifecycle shows e2e SDK: JWT/Cognito is handled behind the scenes,
// Go's testing.T handles orchestration (t.Run, table tests, t.Parallel).
func TestUserLifecycle(t *testing.T) {
	api := apitest.New(t) // loads config/environments.yaml + OpenAPI, mints JWT lazily

	email := fmt.Sprintf("e2e+%d@example.com", time.Now().UnixNano())
	var userID string

	// Go typesafety: body can be a typed struct from your backend's oapi-codegen
	t.Run("create", func(t *testing.T) {
		api.POST(t, "/users", apitest.WithBody(map[string]any{
			"email": email,
			"name":  "e2e",
		})).ExpectStatus("201").Capture("$.id", &userID)
	})

	t.Run("get", func(t *testing.T) {
		api.GET(t, "/users/{id}", apitest.WithPath("id", userID)).
			ExpectStatusCode(200).
			ExpectJSON("$.email", email)
	})

	t.Run("concrete_path", func(t *testing.T) {
		// concrete path auto-extracts params: /users/u-123 -> {id: u-123}
		api.GET(t, "/users/"+userID).ExpectStatusCode(200)
	})
}

func TestListUsers_TableDriven(t *testing.T) {
	api := apitest.New(t)
	for _, tc := range []struct {
		name string
		page string
		want string
	}{
		{"page1", "1", "2xx"},
		{"page2", "2", "2xx"},
	} {
		t.Run(tc.name, func(t *testing.T) {
			// t.Parallel() works because each subtest uses same Client (JWT cached, thread-safe)
			api.GET(t, "/users", apitest.WithQuery("page", tc.page)).ExpectStatus(tc.want)
		})
	}
}

func TestPublicEndpoint_NoAuth(t *testing.T) {
	api := apitest.New(t)
	// POST /auth/login is public per OpenAPI (security: []), SDK skips JWT automatically.
	// Or force with WithRequestNoAuth().
	api.POST(t, "/auth/login",
		apitest.WithBody(map[string]any{"email": "x@example.com", "password": "secret"}),
		apitest.WithRequestNoAuth(),
	).ExpectStatus("200")
}
