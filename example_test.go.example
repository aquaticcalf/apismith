// Copy to e2e/users_test.go and run with env vars (no yaml):
//   APITEST_BASE_URL=http://localhost:8080/api/v1 \
//   COGNITO_USER_POOL_ID=ap-south-1_xxx COGNITO_CLIENT_ID=xxx \
//   COGNITO_USERNAME=user@example.com COGNITO_PASSWORD=secret \
//   go test ./e2e -v
package e2e_test

import (
	"fmt"
	"testing"
	"time"

	"aegion-dynamic/apismith/apitest"
)

func TestUserLifecycle(t *testing.T) {
	api := apitest.New(t) // single env from APITEST_BASE_URL, JWT lazily minted

	email := fmt.Sprintf("e2e+%d@example.com", time.Now().UnixNano())
	var id string

	t.Run("create", func(t *testing.T) {
		api.POST(t, "/users", apitest.WithBody(map[string]any{"email": email, "name": "e2e"})).
			ExpectStatus("201").Capture("$.id", &id)
	})
	t.Run("get", func(t *testing.T) {
		api.GET(t, "/users/{id}", apitest.WithPath("id", id)).
			ExpectStatusCode(200).ExpectJSON("$.email", email)
	})
}
