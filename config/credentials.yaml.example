# Copy to credentials.yaml (gitignored) or pass a JSON file to jwt-cli.
# Compatible with jwt-token-printer's config.json shape.

userPoolID: "ap-south-1_xxxxxxxx"
clientID: ""
clientSecret: ""
username: ""
password: ""
region: "ap-south-1"

# Optional. Defaults to USER_SRP_AUTH (same as jwt-token-printer).
# Use "password" for USER_PASSWORD_AUTH (often easier with cognito-local).
authFlow: "srp"

# Optional Cognito API override (cognito-local).
# endpoint: "http://localhost:9229"
